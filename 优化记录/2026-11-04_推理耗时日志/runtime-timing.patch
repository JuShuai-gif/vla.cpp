+    def test_vla_prints_one_timing_line_per_prediction_and_keeps_native_telemetry(self):
+        result = self.run_inference(.12, backend='vla_cpp')
+        lines = [line for line in result.output.splitlines() if line.startswith('[vla_cpp predict #')]
+        self.assertGreaterEqual(result.calls, 2)
+        self.assertEqual(len(lines), result.calls)
+        for number, line in enumerate(lines, 1):
+            self.assertTrue(line.startswith(f'[vla_cpp predict #{number}] '))
+            self.assertIn('native_call_ms=1.25', line)
+            self.assertIn('preprocess_ms=0.50', line)
+            self.assertIn('postprocess_ms=0.25', line)
+            self.assertIn('predict_ms=', line)
+            self.assertIn('observation_to_prediction_ms=', line)
+        metrics = [row for kind, row in result.events if kind == 'metric' and 'predict_ms' in row]
+        self.assertEqual(len(metrics), result.calls)
+        self.assertTrue(all(row['backend_native_call_ms'] == 1.25 for row in metrics))
+
